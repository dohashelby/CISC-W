+    def avep_retire_ctfr(self) -> dict[str, object]:
+        """Validate and retire two principal shadows at a quiescent barrier."""
+        if self._pcfr_mode_id != _CTFR_FULL:
+            return {
+                "retired": False,
+                "reason": "CTFR retirement requires ctfr-full mode",
+            }
+
+        torch.accelerator.synchronize()

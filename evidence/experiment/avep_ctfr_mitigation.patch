+                candidate_info.stride(0),
+                candidate_info.stride(1),
+                candidate_grad,
+                candidate_grad.stride(0),
+                candidate_grad.stride(1),
+                candidate_counts,
+                candidate_counts.stride(0),
+                DOMAIN=domain,
+                NUM_SPECULATIVE_STEPS=self.num_speculative_steps,
+                L2=self.L2,
+                DAMPING=self.DAMPING_OBSERVATIONS,

@@ -997,6 +997,25 @@ class Worker(WorkerBase):
             "reset": result,
         }
 
+    def avep_set_acceptance_estimator_updates(
+        self, enabled: str
+    ) -> dict[str, Any]:
+        """Toggle estimator observations for a localhost research ablation."""
+        if enabled not in {"true", "false"}:
+            raise ValueError("enabled must be the string 'true' or 'false'")
+        speculator = getattr(self.model_runner, "speculator", None)
+        estimator = getattr(speculator, "acceptance_estimator", None)
+        if estimator is None:
+            return {
+                "available": False,
+                "reason": "No online acceptance estimator is active",
+            }
+        result = estimator.avep_set_updates_enabled(enabled == "true")
+        return {
+            "available": True,
+            "update_gate": result,
+        }
+
     def get_model(self) -> nn.Module:
         return self.model_runner.get_model()
 

+    num_reqs,
+    BLOCK_R: tl.constexpr,
+):
+    step = tl.program_id(0).to(tl.int64)
+    req_block = tl.arange(0, BLOCK_R)
+    req_mask = req_block < num_reqs
+    req_state_block = tl.load(
+        idx_mapping_ptr + req_block, mask=req_mask, other=0
+    ).to(tl.int64)
+    principal = tl.load(
+        feedback_principal_ptr + req_state_block,
+        mask=req_mask,
+        other=-1,
+    ).to(tl.int32)
+    num_sampled = tl.load(
+        num_sampled_ptr + req_block, mask=req_mask, other=0
+    ).to(tl.int64)
+    num_accepted = tl.maximum(num_sampled - 1, 0)
+    num_rejected = tl.load(
+        num_rejected_ptr + req_block, mask=req_mask, other=0
+    ).to(tl.int64)
+    num_admitted = num_accepted + num_rejected
+    observed = req_mask & (step <= num_accepted) & (step < num_admitted)
+    label = tl.where(step < num_accepted, 1.0, 0.0)
+    prediction = tl.load(
+        pred_ptr + req_state_block * pred_stride + step,
+        mask=req_mask,
+        other=0.5,
+    ).to(tl.float32)
+    prediction = tl.minimum(tl.maximum(prediction, 1.0e-6), 1.0 - 1.0e-6)
+
+    for principal_id in tl.static_range(_NUM_CTFR_PRINCIPALS):
+        selected = observed & (principal == principal_id)
+        log_loss = -label * tl.log(prediction) - (1.0 - label) * tl.log(
+            1.0 - prediction
+        )
+        brier = (prediction - label) * (prediction - label)
+        offset = principal_id * loss_principal_stride + step
+        tl.store(
+            loss_ptr + offset,
+            tl.load(loss_ptr + offset)
+            + tl.sum(tl.where(selected, log_loss, 0.0), axis=0),
+        )
+        tl.store(
+            brier_ptr + principal_id * brier_principal_stride + step,
+            tl.load(
+                brier_ptr
+                + principal_id * brier_principal_stride
+                + step
+            )
+            + tl.sum(tl.where(selected, brier, 0.0), axis=0),
+        )
+        tl.store(
+            counts_ptr + principal_id * counts_principal_stride + step,
+            tl.load(
+                counts_ptr
+                + principal_id * counts_principal_stride
+                + step
+            )
+            + tl.sum(tl.where(selected, 1.0, 0.0), axis=0),
+        )

+def _evaluate_kernel(
+    idx_mapping_ptr,
+    num_sampled_ptr,
+    num_rejected_ptr,
+    feedback_principal_ptr,
+    pred_ptr,
+    pred_stride,
+    loss_ptr,
+    loss_principal_stride,
+    brier_ptr,
+    brier_principal_stride,
+    counts_ptr,

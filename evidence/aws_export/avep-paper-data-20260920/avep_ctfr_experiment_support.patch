+    def avep_load_committed_state(
+        self, serialized_json: str
+    ) -> dict[str, object]:
+        """Load one frozen baseline into every coefficient bank."""
+        payload = json.loads(serialized_json)
+        if not isinstance(payload, dict):
+            raise ValueError("baseline state must be a JSON object")
+        slope = payload.get("slope")
+        intercepts = payload.get("intercepts")
+        if (
+            isinstance(slope, bool)
+            or not isinstance(slope, (int, float))
+            or not math.isfinite(slope)
+        ):
+            raise ValueError("baseline slope must be finite")
+        if slope < 0:
+            raise ValueError("baseline slope must be non-negative")
+        if not isinstance(intercepts, list) or len(intercepts) != (
+            self.num_speculative_steps
+        ):
+            raise ValueError("baseline intercept count does not match draft depth")
+        if any(
+            isinstance(value, bool)
+            or not isinstance(value, (int, float))
+            or not math.isfinite(value)
+            for value in intercepts
+        ):
+            raise ValueError("baseline intercepts must be finite numbers")
+        normalized_intercepts = [float(value) for value in intercepts]
+
+        canonical = json.dumps(
+            {"slope": float(slope), "intercepts": normalized_intercepts},
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        digest = hashlib.sha256(canonical.encode()).hexdigest()
+        slope_tensor = torch.tensor(
+            float(slope), dtype=torch.float32, device=self.device
+        )
+        intercept_tensor = torch.tensor(
+            normalized_intercepts, dtype=torch.float32, device=self.device
+        )
+        with torch.no_grad():
+            self.slope.copy_(slope_tensor.expand_as(self.slope))
+            self.intercepts.copy_(
+                intercept_tensor.expand_as(self.intercepts)
+            )
+            self.info.zero_()
+            self.grad.zero_()
+            self.counts.zero_()
+            self.features.zero_()
+            self.predictions.zero_()
+            self.feedback_domains.zero_()
+            self.feedback_principals.fill_(-1)
+            self.eval_log_loss.zero_()
+            self.eval_brier.zero_()
+            self.eval_counts.zero_()
+        self._steps_since_refit = [0] * _NUM_FEEDBACK_DOMAINS
+        self._refits = [0] * _NUM_FEEDBACK_DOMAINS
+        self._tenant_local_versions = [0] * _NUM_CTFR_PRINCIPALS
+        self._committed_version = 0
+        self._ctfr_influence_credits = [
+            self._ctfr_bucket_capacity
+        ] * _NUM_CTFR_PRINCIPALS

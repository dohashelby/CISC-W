diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -971,6 +971,32 @@ class Worker(WorkerBase):
     def reset_encoder_cache(self) -> None:
         self.model_runner.reset_encoder_cache()
 
+    def avep_get_acceptance_estimator_state(self) -> dict[str, Any]:
+        """Return the experimental estimator state for localhost-only tests."""
+        speculator = getattr(self.model_runner, "speculator", None)
+        estimator = getattr(speculator, "acceptance_estimator", None)
+        if estimator is None:
+            return {
+                "available": False,
+                "reason": "No online acceptance estimator is active",
+            }
+        return estimator.avep_state()
+
+    def avep_reset_acceptance_estimator(self) -> dict[str, Any]:
+        """Reset the estimator in place while preserving the loaded models."""
+        speculator = getattr(self.model_runner, "speculator", None)
+        estimator = getattr(speculator, "acceptance_estimator", None)
+        if estimator is None:
+            return {
+                "available": False,
+                "reason": "No online acceptance estimator is active",
+            }
+        result = estimator.avep_reset()
+        return {
+            "available": True,
+            "reset": result,
+        }
+
     def get_model(self) -> nn.Module:
         return self.model_runner.get_model()
 
